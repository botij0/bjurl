PORT=3334
PUBLIC_PATH=public

BASE_URL=your_domain

# Replace change_me with a strong password for your local Postgres.
POSTGRES_URL=postgresql://postgres:change_me@localhost:5432/URL
POSTGRES_USER=postgres
POSTGRES_DB=URL
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change_me

IP_HASH_SALT=change_me

# "*" allows every origin (fine for a public shortener). Set a comma-separated
# allow-list, e.g. CORS_ORIGIN=https://bjurl.example.com, to restrict it.
CORS_ORIGIN=*