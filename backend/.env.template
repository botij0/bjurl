PORT=3334
PUBLIC_PATH=public

BASE_URL=your_domain

POSTGRES_URL=postgresql://postgres:123456@localhost:5432/URL
POSTGRES_USER=postgres
POSTGRES_DB=URL
POSTGRES_PORT=5432
POSTGRES_PASSWORD=123456

# IP_HASH_SALT must be a random secret, e.g. the output of `openssl rand -hex 32`.
# The app refuses to start while this value is empty or an obvious placeholder.
IP_HASH_SALT=REPLACE_WITH_RANDOM_SECRET

# "*" allows every origin (fine for a public shortener). Set a comma-separated
# allow-list, e.g. CORS_ORIGIN=https://bjurl.example.com, to restrict it.
CORS_ORIGIN=*
